# World of Trucks credentials (your personal account)
WOT_LOGIN=your-username-or-email
WOT_PASSWORD=your-password

# Your numeric profile id (from your profile URL: worldoftrucks.com/en/profile/<ID>)
WOT_PROFILE_ID=11363631

# SQLite database file
DATABASE_URL=./data/trucksim.db

# Steam (optional) — adds ETS2/ATS playtime to the dashboard.
# API key: https://steamcommunity.com/dev/apikey
# STEAM_ID is your 64-bit SteamID64 (e.g. 7656119...). Your Steam profile's
# "Game details" privacy must be set to Public.
STEAM_API_KEY=
STEAM_ID=

# Netlify deploy (used by `npm run publish`)
# Token:   Netlify → User settings → Applications → Personal access tokens → New
# Site ID: create the site once (drag the build/ folder onto Netlify), then
#          Site configuration → Site details → "Site ID"
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
